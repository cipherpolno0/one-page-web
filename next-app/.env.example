# Local SQLite database for development and tests. Use a PostgreSQL DATABASE_URL when deploying.
DATABASE_URL="file:./dev.db"

# Generate a unique value with `openssl rand -base64 32`; never commit the real value.
NEXTAUTH_SECRET="replace-with-a-unique-secret"
# Public base URL for the local or deployed application.
NEXTAUTH_URL="http://localhost:3000"
# Provide only when creating the local sample administrator; never commit a real password.
# ADMIN_SEED_PASSWORD="replace-with-a-local-development-password"
